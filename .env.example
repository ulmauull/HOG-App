# =======================================================
# SUPABASE CONFIGURATION — HOME OF GAMERS (HOG)
# =======================================================

# 1. Supabase Project API & Cloud Storage
# Dapatkan di: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_STORAGE_BUCKET=payment-proofs

# 2. Supabase PostgreSQL Connection (Transaction Pooler - Port 6543 atau Direct - Port 5432)
# Dapatkan di: Supabase Dashboard -> Project Settings -> Database -> Connection parameters
HOG_DB_DRIVER=pgsql
SUPABASE_DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.your-project-ref
SUPABASE_DB_PASS=PasswordDatabaseSupabaseAnda

# 3. Next.js Frontend Public Environment Variables
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
